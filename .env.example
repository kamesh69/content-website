WORDPRESS_GRAPHQL_URL=https://cms.thesportsrivalry.com/graphql
NEWSLETTER_URL=https://newsletter.example.com

# Preview + revalidation (must match WordPress Headless Settings)
WORDPRESS_PREVIEW_SECRET=change-me-to-a-long-random-string
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Optional: Base64-encoded "username:application-password" for draft previews via GraphQL
# WORDPRESS_PREVIEW_AUTH=

# Migration script only — WordPress Application Password for an admin user
# WORDPRESS_REST_USER=your-wp-username
# WORDPRESS_REST_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
